		dataType: int64
		isHidden
		lineageTag: 94b4980e-82ed-45e3-b097-77d5b6791598
		summarizeBy: none
		sourceColumn: [Latest Active Weeks]

	column 'Latest Active Week Rate'
		dataType: decimal
		isHidden
		lineageTag: ac3152a1-d24c-4452-9edd-05330e2d516d
