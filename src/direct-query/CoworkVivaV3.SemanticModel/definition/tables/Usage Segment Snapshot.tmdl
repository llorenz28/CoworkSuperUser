/// Latest and previous selected-window usage stages, movement, and champion cohort for each person.
table 'Usage Segment Snapshot'
	lineageTag: 35fff33a-6f76-4c2f-8c17-699f0109880d

	/// People with complete Cowork coverage in the latest selected rolling-window window.
	measure 'Latest Classified Population' =
			CALCULATE(
			    DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			    'Usage Segment Snapshot'[Latest Coverage Status] = "Complete"
			)
		formatString: #,##0
		isHidden
		displayFolder: Coverage
		lineageTag: ed21fed7-8f3e-495a-b917-5e4dcc3f7cc9

	/// People with complete Cowork coverage in the previous selected rolling-window window.
	measure 'Previous Classified Population' =
			CALCULATE(
			    DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Previous Segment]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Previous Segment Sort]),
			    'Usage Segment Snapshot'[Previous Coverage Status] = "Complete"
			)
		formatString: #,##0
		isHidden
		displayFolder: Coverage
		lineageTag: d4ea7f69-111a-407f-9b1e-5e786dc05fbe

	/// People with complete Cowork coverage in both rolling windows.
	measure 'Movement Comparable Population' =
			CALCULATE(
			    DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Movement]),
			    REMOVEFILTERS('Usage Segment Snapshot'[Movement Sort]),
			    'Usage Segment Snapshot'[Latest Coverage Status] = "Complete",
			    'Usage Segment Snapshot'[Previous Coverage Status] = "Complete"
			)
		formatString: #,##0
		isHidden
		displayFolder: Coverage
		lineageTag: fe33bbf9-5f39-4ab9-9300-ba149042e3b4

	/// People in the latest Cowork stage context when privacy-safe.
	measure 'Latest Segment People' =
			VAR _people = DISTINCTCOUNT('Usage Segment Snapshot'[Person ID])
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 961075ed-922b-4b6f-bd3a-e400810284d1

	/// Latest Cowork stage share.
	measure 'Latest Segment Share' = DIVIDE([Latest Segment People], [Latest Classified Population])
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: 4cfefe37-fafa-4f06-8d79-1870bc1c5f4c

	/// Average weekly Cowork sessions for people in the selected latest stage; privacy suppressed.
	measure 'Average Sessions per Person' =
			VAR _people =
			    DISTINCTCOUNT('Usage Segment Snapshot'[Person ID])
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    AVERAGE('Usage Segment Snapshot'[Latest Average Weekly Sessions])
			)
		formatString: #,##0.0
		displayFolder: Latest stage
		lineageTag: dd54cabf-7b9e-49a2-b18a-5c31c6003a46

	/// People in the latest Cowork Power User stage.
	measure 'Power Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Power User"
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: a187eb15-d21b-4b26-89b0-f18946055665

	/// Share in the latest Cowork Power User stage.
	measure 'Power User Share' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Power User"
			    )
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    DIVIDE(_people, [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: 6781b26c-df61-455a-8eb6-2bc211eca77f

	/// People in the latest Cowork Habitual User stage.
	measure 'Habitual Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Habitual User"
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 63aa8691-b0bc-43fb-a77b-52254ea020fb

	/// Share in the latest Cowork Habitual User stage.
	measure 'Habitual User Share' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Habitual User"
			    )
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    DIVIDE(_people, [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: f7c7c2f5-eb40-4fa2-8e0c-295367a30d01

	/// People in the latest Cowork Developing User stage.
	measure 'Developing Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Developing User"
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 0a174644-1fe6-4ea4-a496-ea4fcecc3051

	/// Share in the latest Cowork Developing User stage.
	measure 'Developing User Share' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Developing User"
			    )
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    DIVIDE(_people, [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: a0121658-5b7d-4d46-8888-13e45670efc4

	/// People in the latest Cowork Low User stage.
	measure 'Low Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Low User"
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: c8063497-41cf-4ddc-ba10-870d68e4cbfc

	/// Share in the latest Cowork Low User stage.
	measure 'Low User Share' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Low User"
			    )
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    DIVIDE(_people, [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: 831e56c8-7bff-4c4b-ab80-92efc8b5282c

	/// People in the latest Cowork Non-user stage.
	measure Non-users =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Non-user"
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 9e634ee2-35a2-4d40-b8b6-8107402011e2

	/// Share in the latest Cowork Non-user stage.
	measure 'Non-user Share' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] = "Cowork Non-user"
			    )
			RETURN
			IF(
			    [Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor],
			    DIVIDE(_people, [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: a24a4c7c-53a7-47e6-9d52-4daf3378d60d

	/// People in the latest Cowork Power or Habitual stage; returns an explicit 0/1 value on authorized employee-detail rows.
	measure 'Sustained Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] IN {"Cowork Power User", "Cowork Habitual User"}
			    )
			RETURN
			IF(
			    ISINSCOPE('Organization'[User ID]),
			    COALESCE(_people, 0),
			    IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
			)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 4aa192af-4993-4c3e-81d6-afe02c1c320d

	/// Cowork Power and Habitual users divided by people with complete latest-window coverage; returns 0% or 100% on employee-detail rows.
	measure 'Sustained Usage Share' =
			IF(
			    ISINSCOPE('Organization'[User ID]),
			    IF(
			        SELECTEDVALUE('Usage Segment Snapshot'[Latest Coverage Status]) = "Complete",
			        [Sustained Users]
			    ),
			    DIVIDE([Sustained Users], [Latest Classified Population])
			)
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: 379931fe-6fa0-4183-a2b6-bec15d373147

	/// People with any activity in the latest selected rolling-window window.
	measure 'Latest Window Active Users' =
			VAR _people =
			    CALCULATE(
			        DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment]),
			        REMOVEFILTERS('Usage Segment Snapshot'[Latest Segment Sort]),
			        'Usage Segment Snapshot'[Latest Segment] IN {
			            "Cowork Power User",
			            "Cowork Habitual User",
			            "Cowork Developing User",
			            "Cowork Low User"
			        }
			    )
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Latest stage
		lineageTag: 25b728f0-20e5-42d5-82ec-4512de49954c

	/// Latest selected rolling-window active users divided by people with complete latest-window coverage.
	measure 'Latest Window Reach' = DIVIDE([Latest Window Active Users], [Latest Classified Population])
		formatString: 0.0%
		displayFolder: Latest stage
		lineageTag: 9caf658e-57a3-42e0-9fda-d0ac751a9417

	/// People in the selected stage-movement class when privacy-safe.
	measure 'Movement People' =
			VAR _movement = SELECTEDVALUE('Adoption Movement'[Movement])
			VAR _people = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), TREATAS({_movement}, 'Usage Segment Snapshot'[Movement]))
			RETURN IF([Movement Comparable Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Movement
		lineageTag: 21c7c159-4b05-4e2d-a449-30cdaa0ef835

	/// Privacy-safe movement share.
	measure 'Movement Share' = DIVIDE([Movement People], [Movement Comparable Population])
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: 76d3f825-5bea-4206-b4b3-6bdbbeb67793

	/// People whose Cowork stage improved when privacy-safe.
	measure 'Improved People' =
			VAR _people = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Movement] = "Improved")
			RETURN IF([Movement Comparable Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Movement
		lineageTag: 3a47f4e3-caaf-417d-8925-83c94291483f

	/// People whose Cowork stage stayed stable when privacy-safe; returns an explicit 0/1 value on authorized employee-detail rows.
	measure 'Stable People' =
			VAR _people = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Movement] = "Stable")
			RETURN
			IF(
			    ISINSCOPE('Organization'[User ID]),
			    COALESCE(_people, 0),
			    IF([Movement Comparable Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
			)
		formatString: #,##0
		displayFolder: Movement
		lineageTag: 34525bf5-30e0-4298-9e42-7450cf099046

	/// People whose Cowork stage declined when privacy-safe.
	measure 'Declined People' =
			VAR _people = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Movement] = "Declined")
			RETURN IF([Movement Comparable Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Movement
		lineageTag: fccc9f28-9a48-46e5-886f-673dfb30b3a4

	/// People in the selected Cowork stage transition when privacy-safe.
	measure 'Transition People' =
			VAR _people = DISTINCTCOUNT('Usage Segment Snapshot'[Person ID])
			RETURN IF([Movement Comparable Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Movement
		lineageTag: da24f61d-b59f-4510-b4ea-252339f4ed3b

	/// Share of previously sustained Cowork users still sustained; returns 0% or 100% for applicable employee-detail rows.
	measure 'Sustained Retention Rate' =
			VAR _previousSustained = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Previous Sustained] = "Yes")
			VAR _retained = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Previous Sustained] = "Yes", 'Usage Segment Snapshot'[Latest Sustained] = "Yes")
			RETURN
			IF(
			    ISINSCOPE('Organization'[User ID]),
			    IF(
			        SELECTEDVALUE('Usage Segment Snapshot'[Previous Sustained]) = "Yes",
			        IF(SELECTEDVALUE('Usage Segment Snapshot'[Latest Sustained]) = "Yes", 1, 0)
			    ),
			    IF(
			        [Movement Comparable Population] >= [Privacy Floor]
			            && _previousSustained >= [Privacy Floor]
			            && _retained >= [Privacy Floor],
			        DIVIDE(_retained, _previousSustained)
			    )
			)
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: c86eb7e6-1afa-474f-8644-0080bf639a60

	/// Aggregate Cowork Power and Habitual cohort size.
	measure 'Champion Cohort People' =
			VAR _people = CALCULATE(DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]), 'Usage Segment Snapshot'[Latest Segment] IN {"Cowork Power User", "Cowork Habitual User"})
			RETURN IF([Latest Classified Population] >= [Privacy Floor] && _people >= [Privacy Floor], _people)
		formatString: #,##0
		displayFolder: Champion cohorts
		lineageTag: 6aa5e21c-00a8-43fc-a6c5-132a93108b46

	/// Aggregate Cowork Power and Habitual cohort share.
	measure 'Champion Cohort Share' = DIVIDE([Champion Cohort People], [Latest Classified Population])
		formatString: 0.0%
		displayFolder: Champion cohorts
		lineageTag: 8ea3807d-f58e-4f5e-9a6b-ef481f926b04

	/// Potential champions in the fixed top 10% of sustained users for the latest selected-window window.
	measure 'Champion Candidate Count' =
			CALCULATE(
			    DISTINCTCOUNT('Usage Segment Snapshot'[Person ID]),
			    'Usage Segment Snapshot'[Champion Candidate] = "Yes"
			)
		formatString: #,##0
		displayFolder: Champion identification
		lineageTag: edd59e67-0408-42a5-98ba-60b3e569dabc

	/// Average active weeks among potential champions in the latest selected-window window.
	measure 'Champion Candidate Average Active Weeks' =
			CALCULATE(
			    AVERAGE('Usage Segment Snapshot'[Latest Active Weeks]),
			    'Usage Segment Snapshot'[Champion Candidate] = "Yes"
			)
		formatString: 0.0
		displayFolder: Champion identification
		lineageTag: e623a29b-e61e-4459-9a57-0e32ca880ae9

	/// Average weekly Cowork sessions among potential champions in the latest selected-window window.
	measure 'Champion Candidate Average Weekly Sessions' =
			CALCULATE(
			    AVERAGE('Usage Segment Snapshot'[Latest Average Weekly Sessions]),
			    'Usage Segment Snapshot'[Champion Candidate] = "Yes"
			)
		formatString: 0.0
		displayFolder: Champion identification
		lineageTag: b9800b3b-a896-47fd-97a7-19f5846ce08a

	/// Share of visible departments with at least one potential champion.
	measure 'Champion Department Coverage' =
			VAR _departments =
			    FILTER(
			        ALLSELECTED('Organization'[Function]),
			        'Organization'[Function] <> "Not provided"
			    )
			VAR _covered =
			    COUNTROWS(
			        FILTER(
			            _departments,
			            CALCULATE([Champion Candidate Count]) > 0
			        )
			    )
			RETURN DIVIDE(_covered, COUNTROWS(_departments))
		formatString: 0%
		displayFolder: Champion identification
		lineageTag: 74ad35f2-c6c6-486e-a4cf-a625de1efc62

	/// Global candidate order based on active weeks, then average weekly sessions.
	measure 'Champion Rank' =
			IF(
			    SELECTEDVALUE('Usage Segment Snapshot'[Champion Candidate]) = "Yes",
			    MAX('Usage Segment Snapshot'[Champion Candidate Rank])
			)
		formatString: #,##0
		displayFolder: Champion identification
		lineageTag: 645e9992-b12b-4b11-8a8e-89d779f924bd

	/// Plain-language activity evidence for a potential champion.
	measure 'Champion Evidence Label' =
			IF(
			    SELECTEDVALUE('Usage Segment Snapshot'[Champion Candidate]) = "Yes",
			    SELECTEDVALUE('Usage Segment Snapshot'[Champion Evidence])
			)
		displayFolder: Champion identification
		lineageTag: a578f70e-9476-4f65-a5d0-2344ea7a0f79

	/// Estimated sessions from the average and actual window length used in champion selection.
	measure 'Champion Sessions in Window' =
			IF(
			    SELECTEDVALUE('Usage Segment Snapshot'[Champion Candidate]) = "Yes",
			    ROUND(
			        MAX('Usage Segment Snapshot'[Latest Average Weekly Sessions])
			            * MAX('Usage Segment Snapshot'[Latest Base Weeks]),
			        0
			    )
			)
		formatString: #,##0
		displayFolder: Champion identification
		lineageTag: e32a7732-35d1-4f88-b470-3fb7147b326a

	/// Most recent week with positive Cowork sessions for a potential champion.
	measure 'Champion Last Active Week' =
			IF(
			    SELECTEDVALUE('Usage Segment Snapshot'[Champion Candidate]) = "Yes",
			    CALCULATE(
			        MAX('Consumption Weekly'[Week Start]),
			        'Consumption Weekly'[Sessions] > 0
			    )
			)
		formatString: mmm d, yyyy
		displayFolder: Champion identification
		lineageTag: 8d895ea1-8e5d-49e7-961e-75614c545e9a

