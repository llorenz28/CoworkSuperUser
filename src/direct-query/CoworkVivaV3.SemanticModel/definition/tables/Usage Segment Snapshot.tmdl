		sourceColumn: [Latest Average Weekly Sessions]

	column 'Latest Average Weekly Credits'
		dataType: decimal
		isHidden
		lineageTag: 4c172884-4e9a-4a8d-9da0-6fda3c19a48f
		summarizeBy: none
		sourceColumn: [Latest Average Weekly Credits]

	column 'Latest Segment'
