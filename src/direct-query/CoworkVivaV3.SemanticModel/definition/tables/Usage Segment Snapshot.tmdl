	partition 'Usage Segment Snapshot' = calculated
		mode: import
		source =
				VAR _windows =
				    DISTINCT(
				        SELECTCOLUMNS(
				            'Usage Segments Weekly',
				            "Window Weeks", 'Usage Segments Weekly'[Window Weeks]
				        )
				    )
				RETURN
				GENERATE(
				    _windows,
				    VAR _selectedWindow = [Window Weeks]
				    VAR _latestEnd =
				        MAXX(
				            FILTER(
				                ALL('Usage Segments Weekly'),
				                'Usage Segments Weekly'[Window Weeks] = _selectedWindow
				            ),
				            'Usage Segments Weekly'[Window End]
				        )
				    VAR _previousEnd = _latestEnd - 7
				    VAR _latest =
				        SELECTCOLUMNS(
				            FILTER(
				                ALL('Usage Segments Weekly'),
				                'Usage Segments Weekly'[Window Weeks] = _selectedWindow
				                    && 'Usage Segments Weekly'[Window End] = _latestEnd
				            ),
				            "Person ID", 'Usage Segments Weekly'[Person ID] & "",
				            "Person Sort", 'Usage Segments Weekly'[Person Sort],
				            "Window Label", 'Usage Segments Weekly'[Window Label],
				            "Latest Window End", 'Usage Segments Weekly'[Window End],
				            "Latest Base Weeks", 'Usage Segments Weekly'[Base Weeks],
				            "Latest Observed Weeks", 'Usage Segments Weekly'[Observed Weeks],
				            "Latest Coverage Status", 'Usage Segments Weekly'[Coverage Status],
				            "Latest Classification Status", 'Usage Segments Weekly'[Classification Status],
				            "Latest Active Weeks", 'Usage Segments Weekly'[Active Weeks],
				            "Latest Active Week Rate", 'Usage Segments Weekly'[Active Week Rate],
				            "Latest Average Weekly Sessions", 'Usage Segments Weekly'[Average Weekly Sessions],
				            "Latest Average Weekly Credits", 'Usage Segments Weekly'[Average Weekly Credits],
				            "Latest Segment", 'Usage Segments Weekly'[Usage Segment],
				            "Latest Segment Sort", 'Usage Segments Weekly'[Segment Sort],
				            "Transition Latest Stage", 'Usage Segments Weekly'[Usage Segment],
				            "Transition Latest Stage Sort",
				                SWITCH(
				                    'Usage Segments Weekly'[Usage Segment],
				                    "Cowork Non-user", 1,
				                    "Cowork Low User", 2,
				                    "Cowork Developing User", 3,
				                    "Cowork Habitual User", 4,
				                    "Cowork Power User", 5,
				                    6
				                ),
				            "Power Session Threshold", 'Usage Segments Weekly'[Power Session Threshold]
				        )
				    VAR _previous =
				        SELECTCOLUMNS(
				            FILTER(
				                ALL('Usage Segments Weekly'),
				                'Usage Segments Weekly'[Window Weeks] = _selectedWindow
				                    && 'Usage Segments Weekly'[Window End] = _previousEnd
				            ),
				            "Person ID", 'Usage Segments Weekly'[Person ID] & "",
				            "Previous Window End", 'Usage Segments Weekly'[Window End],
				            "Previous Base Weeks", 'Usage Segments Weekly'[Base Weeks],
				            "Previous Observed Weeks", 'Usage Segments Weekly'[Observed Weeks],
				            "Previous Coverage Status", 'Usage Segments Weekly'[Coverage Status],
				            "Previous Classification Status", 'Usage Segments Weekly'[Classification Status],
				            "Previous Active Weeks", 'Usage Segments Weekly'[Active Weeks],
				            "Previous Active Week Rate", 'Usage Segments Weekly'[Active Week Rate],
				            "Previous Average Weekly Sessions", 'Usage Segments Weekly'[Average Weekly Sessions],
				            "Previous Average Weekly Credits", 'Usage Segments Weekly'[Average Weekly Credits],
				            "Previous Segment", 'Usage Segments Weekly'[Usage Segment],
				            "Previous Segment Sort", 'Usage Segments Weekly'[Segment Sort],
				            "Transition Previous Stage", 'Usage Segments Weekly'[Usage Segment],
				            "Transition Previous Stage Sort",
				                SWITCH(
				                    'Usage Segments Weekly'[Usage Segment],
				                    "Cowork Non-user", 1,
				                    "Cowork Low User", 2,
				                    "Cowork Developing User", 3,
				                    "Cowork Habitual User", 4,
				                    "Cowork Power User", 5,
				                    6
				                )
				        )
				    VAR _joined = NATURALLEFTOUTERJOIN(_latest, _previous)
				    VAR _states =
				        ADDCOLUMNS(
				            _joined,
				        "Latest Sustained",
				            IF([Latest Segment] IN {"Cowork Power User", "Cowork Habitual User"}, "Yes", "No"),
				        "Previous Sustained",
				            IF([Previous Segment] IN {"Cowork Power User", "Cowork Habitual User"}, "Yes", "No"),
				        "Movement",
				            SWITCH(
				                TRUE(),
				                COALESCE([Previous Base Weeks], 0) = 0, "Insufficient history",
				                [Latest Coverage Status] <> "Complete" || [Previous Coverage Status] <> "Complete", "Coverage incomplete",
				                [Latest Segment Sort] < [Previous Segment Sort], "Improved",
				                [Latest Segment Sort] > [Previous Segment Sort], "Declined",
				                "Stable"
				            ),
				        "Champion Cohort",
				            SWITCH(
				                [Latest Segment],
				                "Cowork Power User", "Cowork Power User cohort",
				                "Cowork Habitual User", "Cowork Habitual User cohort",
				                "Cowork Developing User", "Developing cohort",
				                "Cowork Low User", "Developing cohort",
				                "Cowork Non-user", "Cowork Non-user",
				                "Cowork coverage unknown", "Coverage unknown",
				                "Insufficient history"
				            )
				        )
				    VAR _sortedStates =
				        ADDCOLUMNS(
				            _states,
				        "Movement Sort",
				            SWITCH(
				                [Movement],
				                "Improved", 1,
				                "Stable", 2,
				                "Declined", 3,
				                "Coverage incomplete", 4,
				                5
				            ),
				        "Champion Cohort Sort",
				            SWITCH(
				                [Champion Cohort],
				                "Cowork Power User cohort", 1,
				                "Cowork Habitual User cohort", 2,
				                "Developing cohort", 3,
				                "Cowork Non-user", 4,
				                "Coverage unknown", 5,
				                6
				            )
				        )
				    VAR _eligible =
				        FILTER(
				            _sortedStates,
				            [Latest Sustained] = "Yes"
				                && [Latest Base Weeks] > 0
				                && [Latest Coverage Status] = "Complete"
				        )
				    VAR _eligibleCount = COUNTROWS(_eligible)
				    VAR _candidateSlots =
				        IF(_eligibleCount > 0, MAX(1, ROUNDUP(_eligibleCount * 0.10, 0)), 0)
				    VAR _ranked =
				        ADDCOLUMNS(
				            _sortedStates,
				        "Champion Candidate Rank",
				            IF(
				                [Latest Sustained] = "Yes"
				                    && [Latest Base Weeks] > 0
				                    && [Latest Coverage Status] = "Complete",
				                COALESCE(
				                    RANK(
				                        SKIP,
				                        _eligible,
				                        ORDERBY(
				                            [Latest Active Week Rate], DESC,
				                            [Latest Average Weekly Sessions], DESC,
				                            [Person Sort], ASC
				                        ),
				                        ,
				                        ,
				                        MATCHBY([Person Sort])
				                    ),
				                    0
				                ),
				                0
				            )
				        )
				    RETURN
				        ADDCOLUMNS(
				            _ranked,
				        "Champion Candidate",
				            IF(
				                [Champion Candidate Rank] > 0
				                    && [Champion Candidate Rank] <= _candidateSlots,
				                "Yes",
				                "No"
				            ),
				        "Champion Evidence",
				            SWITCH(
				                TRUE(),
				                [Latest Coverage Status] <> "Complete", "Coverage incomplete",
				                [Champion Candidate Rank] > 0
				                    && [Champion Candidate Rank] <= _candidateSlots,
				                    IF(
				                        [Latest Base Weeks] < 4,
				                        "Early sustained-use signal",
				                        IF([Latest Segment] = "Cowork Power User", "High use + sustained", "Sustained use")
				                    ),
				                [Latest Base Weeks] < 4, "Not selected - early history",
				                "Not selected"
				            )
				        )
				)
