            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to use this view",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#311F5E",
                      "fontWeight": "semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Shares  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Latest-window active share is people with complete coverage who used Cowork at least once in the selected 4- or 12-week window. Sustained-use share is the Power + Habitual share.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Value  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Use the department comparison to prioritize aggregate enablement: activate first use, reinforce habits, or scale privacy-safe champion practices.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Privacy & interpretation  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Results below 10 people are suppressed. Recommendations are relative to company benchmarks. They are not maturity scores, not individual performance evaluations, and not proof that Cowork caused an outcome.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#311F5E"
                    }
                  }
                ]
              }
            ]
