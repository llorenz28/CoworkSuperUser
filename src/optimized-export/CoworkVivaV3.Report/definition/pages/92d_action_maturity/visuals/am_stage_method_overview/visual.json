                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use all reliable history available, up to 12 weeks. These groups support enablement planning—not performance evaluation.",
