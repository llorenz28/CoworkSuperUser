              {
                "textRuns": [
                  {
                    "value": "How to use Recommended focus",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#311F5E",
                      "fontWeight": "semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Start with context  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Company reach and repeat-habit cards are benchmarks. Selected total users and Power users update with the current filters and table selection.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Decision rule  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Reach is checked first. Below company → Expand reach. Otherwise, repeat habit below company → Build habit. If both meet company → Scale champions.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Action playbook  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Expand reach: validate access and first-use. Build habit: reinforce recurring workflows. Scale champions: use Power Users as peer coaches.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Boundary  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Groups under 10 are hidden. Recommendations guide aggregate enablement; they do not evaluate employee performance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              }
            ]
