        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What reach and sustained use mean",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#311F5E",
                      "fontWeight": "semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reach  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "People with at least one observed Cowork session in the selected period divided by the analytical population. It shows breadth, not eligibility, skill, or performance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sustained use  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Power or Habitual users divided by the analytical population. Both require activity in at least 75% of available covered weeks up to the selected cap; Power also averages at least 6 sessions per covered week.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gap calculation  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Department share minus company share, in percentage points. The benchmark keeps the same filters except department; left is below and right is above. Read reach and sustained use together. Results below 10 people are suppressed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
