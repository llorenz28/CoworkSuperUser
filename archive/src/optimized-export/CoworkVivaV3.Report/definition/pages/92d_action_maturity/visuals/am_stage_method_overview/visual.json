                      "fontSize": "8pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Active in at least 75% of available covered weeks and averages fewer than 6 sessions per available week.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Developing User  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
