                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Method  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Active-week rate = active weeks divided by available covered weeks. Average weekly sessions = total sessions divided by available covered weeks, including zero-activity weeks. Uses all available Sunday-start Cowork weeks up to the selected 4- or 12-week cap; shorter history is provisional, movement begins with week 2, and groups below 10 people are hidden. A 4-week cap cannot produce Low User because one active week equals 25%; use the 12-week cap with at least 5 available weeks. Stages describe usage—not skill or performance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              }
            ]
