                  {
                    "value": "How usage stage is calculated",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Power User  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Active in at least 75% of available covered weeks and averages at least 6 sessions per available week.   ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#4F5B6B"
