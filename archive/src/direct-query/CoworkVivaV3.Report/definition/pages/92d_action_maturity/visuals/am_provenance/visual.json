            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Usage-stage calculation",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "fontWeight": "semibold",
                      "color": "#311F5E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Power: at least 75% active weeks and at least 6 sessions/available week | Habitual: at least 75% and under 6 | Developing: 25% to under 75% | Low: above 0% to under 25% | Non-user: 0 active weeks.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#172033"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Active-week rate = active weeks / available covered weeks. Session average = total sessions / available covered weeks, including zeros. Uses up to the selected 4/12-week cap; movement starts with week 2; groups below 10 people are hidden.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#4F5B6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4-week limitation: one active week equals 25%, so Low User cannot occur. Use the 12-week cap with at least 5 available weeks to distinguish Low from Developing.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#5A6472"
                    }
                  }
                ]
              }
            ]
          }
        }
