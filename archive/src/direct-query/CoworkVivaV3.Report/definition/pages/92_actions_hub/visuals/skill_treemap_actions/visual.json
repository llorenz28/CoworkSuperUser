                "textRuns": [
                  {
                    "value": "Dimensions  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#172033",
                      "fontWeight": "semibold"
                    }
                  },
                  {
                    "value": "Collaboration network includes internal network size, external network size, and network outside the organization. Beyond-hours work includes after-hours collaboration, weekend collaboration, and collaboration span.",
